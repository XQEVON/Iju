
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080914">
<title>NEONIX</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#080914;color:white;
 font-family:Arial,sans-serif;overflow-x:hidden;
}
body:before{
 content:"";position:fixed;inset:0;pointer-events:none;
 background:radial-gradient(circle at 50% 0%,#25205b 0%,transparent 55%);
 z-index:-1;
}
#particles{position:fixed;inset:0;z-index:-1;pointer-events:none}
header{padding:28px 22px 12px;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:25px;font-weight:900;letter-spacing:3px;color:#9c8cff}
.status{font-size:11px;color:#67ffc3}
main{padding:15px 20px 110px;max-width:600px;margin:auto}
h1{font-size:32px;margin:20px 0 5px}
.muted{color:#9294ad;font-size:13px}
.clock{
 margin:24px 0;padding:27px 20px;border:1px solid #494078;
 border-radius:25px;background:linear-gradient(135deg,#19152f,#101529);
 box-shadow:0 0 35px #6752ff20;
}
#time{font-size:48px;font-weight:800;letter-spacing:2px}
#date{color:#a6a1cb;margin-top:8px}
.section-title{margin:30px 0 14px;font-size:17px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.card{
 min-height:130px;padding:19px;border-radius:20px;
 background:#15172a;border:1px solid #292b48;
 transition:.25s;cursor:pointer;
}
.card:active{transform:scale(.96);background:#242047}
.card .emoji{font-size:29px}
.card h3{font-size:15px;margin:12px 0 5px}
.card p{font-size:11px;color:#9294ad;margin:0}
.panel{
 display:none;margin-top:20px;padding:22px;
 background:#15172a;border:1px solid #393657;border-radius:22px;
 animation:appear .3s ease;
}
.panel.active{display:block}
@keyframes appear{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
button{
 border:0;border-radius:13px;padding:13px 18px;
 background:linear-gradient(120deg,#8067ff,#bd65ff);
 color:white;font-weight:bold;cursor:pointer;margin-top:12px;
}
input,textarea{
 width:100%;padding:14px;border:1px solid #373858;
 border-radius:12px;background:#0c0e1d;color:white;
 margin-top:12px;font:inherit;
}
textarea{min-height:120px;resize:vertical}
.big{font-size:38px;font-weight:800;margin:20px 0}
nav{
 position:fixed;bottom:0;left:0;right:0;
 display:flex;justify-content:space-around;padding:15px;
 background:#101120ee;backdrop-filter:blur(15px);
 border-top:1px solid #292b48;
}
nav button{margin:0;background:transparent;color:#aaa0d8;padding:8px;font-size:12px}
nav button.selected{color:#a58aff}
footer{text-align:center;color:#555873;font-size:11px;margin-top:30px}
</style>
</head>
<body>
<canvas id="particles"></canvas>

<header>
 <div class="logo">NEONIX</div>
 <div class="status">● OFFLINE MODE</div>
</header>

<main>
 <section id="home">
  <h1>Привет!</h1>
  <div class="muted">Твоя цифровая территория.</div>

  <div class="clock">
   <div class="muted">ТВОЁ ВРЕМЯ</div>
   <div id="time">00:00</div>
   <div id="date"></div>
  </div>

  <div class="section-title">Твои инструменты</div>
  <div class="grid">
   <div class="card" onclick="openPanel('game')">
    <div class="emoji">⚡</div>
    <h3>Реакция</h3>
    <p>Проверь скорость</p>
   </div>
   <div class="card" onclick="openPanel('ideas')">
    <div class="emoji">💡</div>
    <h3>Идеи</h3>
    <p>Случайные открытия</p>
   </div>
   <div class="card" onclick="openPanel('notes')">
    <div class="emoji">📝</div>
    <h3>Заметки</h3>
    <p>Записывай мысли</p>
   </div>
   <div class="card" onclick="openPanel('settings')">
    <div class="emoji">⚙️</div>
    <h3>Настройки</h3>
    <p>Твоя персонализация</p>
   </div>
  </div>
 </section>

 <section id="game" class="panel">
  <h2>⚡ Проверка реакции</h2>
  <p class="muted" id="gameText">Нажми «Начать» и дождись зелёного экрана.</p>
  <div class="big" id="result">---</div>
  <button onclick="startGame()">Начать</button>
  <button id="tap" onclick="tapGame()" style="display:none">НАЖМИ!</button>
  <button onclick="goHome()">Назад</button>
 </section>

 <section id="ideas" class="panel">
  <h2>💡 Генератор идей</h2>
  <p class="muted">Новая идея для вдохновения.</p>
  <div class="big" id="idea">✨</div>
  <button onclick="newIdea()">Создать идею</button>
  <button onclick="goHome()">Назад</button>
 </section>

 <section id="notes" class="panel">
  <h2>📝 Мои заметки</h2>
  <textarea id="note" placeholder="Напиши что-нибудь интересное..."></textarea>
  <button onclick="saveNote()">Сохранить</button>
  <p class="muted" id="saved"></p>
  <button onclick="goHome()">Назад</button>
 </section>

 <section id="settings" class="panel">
  <h2>⚙️ Настройки</h2>
  <p class="muted">Версия приложения: 1.0</p>
  <p class="muted">Режим: полностью автономный</p>
  <button onclick="toggleTheme()">Изменить подсветку</button>
  <button onclick="goHome()">Назад</button>
 </section>

 <footer>NEONIX • MADE FOR YOUR WORLD</footer>
</main>

<nav>
 <button class="selected" onclick="goHome()">⌂ Главная</button>
 <button onclick="openPanel('game')">⚡ Игра</button>
 <button onclick="openPanel('ideas')">✦ Идеи</button>
 <button onclick="openPanel('notes')">▤ Заметки</button>
</nav>

<script>
const $=id=>document.getElementById(id);

function updateClock(){
 const d=new Date();
 $('time').textContent=d.toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});
 $('date').textContent=d.toLocaleDateString('ru-RU',{weekday:'long',day:'numeric',month:'long'});
}
updateClock();setInterval(updateClock,1000);

function goHome(){
 document.querySelectorAll('main>section').forEach(x=>x.style.display='none');
 $('home').style.display='block';
 document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
}
function openPanel(id){
 $('home').style.display='none';
 document.querySelectorAll('.panel').forEach(x=>{
  x.classList.remove('active');x.style.display='none';
 });
 $(id).style.display='block';
 $(id).classList.add('active');
}

const ideas=[
 'Создай собственную игру с необычной механикой.',
 'Придумай приложение, которое помогает каждый день.',
 'Создай цифровой мир с секретными комнатами.',
 'Разработай собственный стиль интерфейса.',
 'Придумай необычную мини-игру.',
 'Создай личную коллекцию интересных проектов.',
 'Разработай собственную виртуальную вселенную.'
];
function newIdea(){
 $('idea').textContent=ideas[Math.floor(Math.random()*ideas.length)];
}

function saveNote(){
 try{
  localStorage.setItem('neonix-note',$('note').value);
  $('saved').textContent='✓ Сохранено на устройстве!';
 }catch(e){$('saved').textContent='Не удалось сохранить заметку.'}
}
try{$('note').value=localStorage.getItem('neonix-note')||''}catch(e){}

let waiting=false,started=0,timer=null;
function startGame(){
 clearTimeout(timer);
 waiting=false;
 $('tap').style.display='none';
 $('result').textContent='...';
 $('gameText').textContent='Жди зелёного сигнала!';
 $('game').style.background='#15172a';
 timer=setTimeout(()=>{
  waiting=true;started=performance.now();
  $('game').style.background='#123e32';
  $('result').textContent='🟢';
  $('tap').style.display='inline-block';
  $('gameText').textContent='ЖМИ СЕЙЧАС!';
 },1500+Math.random()*3500);
}
function tapGame(){
 if(!waiting){
  clearTimeout(timer);
  $('result').textContent='Слишком рано!';
  $('gameText').textContent='Попробуй ещё раз.';
  $('tap').style.display='none';
  return;
 }
 waiting=false;
 $('result').textContent=Math.round(performance.now()-started)+' мс';
 $('gameText').textContent='Твоя скорость реакции!';
 $('tap').style.display='none';
 $('game').style.background='#15172a';
}

let accent=0;
function toggleTheme(){
 const colors=['#8067ff','#00cba8','#ff659d','#e8b84c'];
 document.documentElement.style.setProperty('--accent',colors[++accent%colors.length]);
 document.querySelectorAll('button').forEach(b=>{
  if(b.textContent.trim()!=='Назад')b.style.background=colors[accent%colors.length];
 });
}

// Локальная анимация частиц
const canvas=$('particles'),ctx=canvas.getContext('2d');
let particles=[];
function resize(){
 canvas.width=innerWidth;canvas.height=innerHeight;
 particles=Array.from({length:45},()=>({
  x:Math.random()*canvas.width,y:Math.random()*canvas.height,
  r:Math.random()*2+0.5,s:Math.random()*.35+.1
 }));
}
resize();addEventListener('resize',resize);
function animate(){
 ctx.clearRect(0,0,canvas.width,canvas.height);
 particles.forEach(p=>{
  p.y-=p.s;
  if(p.y<0){p.y=canvas.height;p.x=Math.random()*canvas.width}
  ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
  ctx.fillStyle='rgba(161,137,255,.65)';ctx.fill();
 });
 requestAnimationFrame(animate);
}
animate();
</script>
</body>
</html>
