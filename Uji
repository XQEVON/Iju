// ==================== МОДЕЛЬ ====================
data class Habit(
    val id: Long = System.currentTimeMillis(),
    val title: String,
    val emoji: String = "✅",
    val streak: Int = 0,
    val lastDoneDay: Long = 0L
)

// ==================== ХРАНИЛИЩЕ ====================
private val Context.dataStore by preferencesDataStore("habits_prefs")

class HabitRepository(private val context: Context) {
    private val gson = Gson()
    private val KEY = stringPreferencesKey("habits_list")

    val habits: Flow<List<Habit>> = context.dataStore.data.map { prefs ->
        val json = prefs[KEY] ?: "[]"
        val type = object : TypeToken<List<Habit>>() {}.type
        gson.fromJson<List<Habit>>(json, type) ?: emptyList()
    }

    suspend fun save(list: List<Habit>) {
        context.dataStore.edit { prefs ->
            prefs[KEY] = gson.toJson(list)
        }
    }
}

// ==================== VIEWMODEL ====================
class HabitViewModel(app: Application) : AndroidViewModel(app) {
    private val repo = HabitRepository(app)

    val habits = repo.habits.stateIn(
        viewModelScope, SharingStarted.WhileSubscribed(5000), emptyList()
    )

    fun add(title: String, emoji: String) = viewModelScope.launch {
        if (title.isBlank()) return@launch
        val current = habits.value + Habit(title = title.trim(), emoji = emoji.ifBlank { "✅" })
        repo.save(current)
    }

    fun markDone(habit: Habit) = viewModelScope.launch {
        val today = System.currentTimeMillis() / 86_400_000L
        if (habit.lastDoneDay == today) return@launch
        val updated = habits.value.map {
            if (it.id == habit.id)
                it.copy(
                    streak = if (it.lastDoneDay == today - 1) it.streak + 1 else 1,
                    lastDoneDay = today
                )
            else it
        }
        repo.save(updated)
    }

    fun delete(habit: Habit) = viewModelScope.launch {
        repo.save(habits.value.filterNot { it.id == habit.id })
    }
}

// ==================== АКТИВНОСТЬ ====================
class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent {
            MaterialTheme {
                Surface(Modifier.fillMaxSize()) {
                    HabitScreen()
                }
            }
        }
    }
}

// ==================== UI ====================
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun HabitScreen(vm: HabitViewModel = viewModel()) {
    val habits by vm.habits.collectAsState()
    var title by remember { mutableStateOf("") }
    var emoji by remember { mutableStateOf("🔥") }
    val emojis = listOf("🔥", "💧", "📚", "🏃", "🧘", "🥗", "💤", "🎯")

    Column(Modifier.padding(16.dp)) {
        Text("Копилка привычек", fontSize = 26.sp, fontWeight = FontWeight.Bold)
        Text("Работает оффлайн ✈️", fontSize = 12.sp)
        Spacer(Modifier.height(16.dp))

        Row(verticalAlignment = Alignment.CenterVertically) {
            OutlinedTextField(
                value = title,
                onValueChange = { title = it },
                label = { Text("Новая привычка") },
                modifier = Modifier.weight(1f),
                singleLine = true
            )
            Spacer(Modifier.width(8.dp))
            Button(onClick = {
                vm.add(title, emoji); title = ""
            }) { Text("+") }
        }

        Spacer(Modifier.height(8.dp))
        Row {
            emojis.forEach { e ->
                FilterChip(
                    selected = emoji == e,
                    onClick = { emoji = e },
                    label = { Text(e, fontSize = 18.sp) },
                    modifier = Modifier.padding(2.dp)
                )
            }
        }

        Spacer(Modifier.height(16.dp))

        if (habits.isEmpty()) {
            Text("Пока пусто. Добавь первую привычку 👆")
        }

        LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp)) {
            items(habits, key = { it.id }) { habit ->
                Card(Modifier.fillMaxWidth()) {
                    Row(
                        Modifier.padding(12.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(habit.emoji, fontSize = 28.sp)
                        Spacer(Modifier.width(12.dp))
                        Column(Modifier.weight(1f)) {
                            Text(habit.title, fontWeight = FontWeight.SemiBold)
                            Text(
                                if (habit.streak > 0) "🔥 серия: ${habit.streak} дн." else "ещё не начато",
                                fontSize = 12.sp
                            )
                        }
                        IconButton(onClick = { vm.markDone(habit) }) {
                            Text("✅", fontSize = 20.sp)
                        }
                        IconButton(onClick = { vm.delete(habit) }) {
                            Icon(Icons.Default.Delete, contentDescription = "Удалить")
                        }
                    }
                }
            }
        }
    }
}
